{
  "name": "atmospath-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "design:lint": "designmd lint ../DESIGN.md",
    "perf:budget": "vite build --mode test && node scripts/check-web-bundle-budget.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "preview": "vite preview",
    "screenshots:release": "node scripts/capture-release-screenshots.mjs",
    "test:e2e": "vite build --mode test && playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "typescript": "~7.0.2",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.28.0",
    "@google/design.md": "^0.2.0",
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript-eslint": "^8.34.0"
  }
}
