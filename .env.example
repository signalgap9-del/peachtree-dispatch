# --- Routing provider (AtmosPath route engine) ---
# Routing engine selection: "osrm" (default, free) or "google".
# When unset, Google Routes is used automatically if GOOGLE_ROUTES_API_KEY is
# set; otherwise the app runs on OSRM so local development needs no keys.
ROUTING_PROVIDER=osrm
# Google Routes API key (Routes API v2, US-only): https://routes.googleapis.com
# Placeholder only - never commit a real key. Leave empty for OSRM fallback.
GOOGLE_ROUTES_API_KEY=
# OSRM server used while the routing provider is "osrm".
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=12

# --- LLM / LiteLLM Proxy ---
# Master key for authenticating requests to the LiteLLM proxy.
LITELLM_MASTER_KEY=
# API key for the upstream LLM provider (Alibaba Cloud Model Studio).
LLM_API_KEY=
# Enable the LLM integration in platform-api (true/false).
LLM_ENABLED=false
# Base URL of the LiteLLM proxy.
LLM_BASE_URL=http://localhost:4000
# Model name routed through LiteLLM (see infra/docker/litellm/config.yaml).
LLM_MODEL=atmospath
# Maximum tokens per LLM response.
LLM_MAX_TOKENS=2000
# Sampling temperature.
LLM_TEMPERATURE=0.3
# HTTP timeout for LLM calls in milliseconds.
LLM_TIMEOUT_MS=30000
# Daily token budget across all LLM calls.
LLM_DAILY_TOKEN_BUDGET=100000
# Per-request token limit.
LLM_REQUEST_TOKEN_LIMIT=2000

# --- Langfuse (LLM Observability) ---
# Enable Langfuse tracing in platform-api (true/false).
LANGFUSE_ENABLED=false
# Langfuse project public key (create a project at http://localhost:3000).
LANGFUSE_PUBLIC_KEY=
# Langfuse project secret key.
LANGFUSE_SECRET_KEY=
# Langfuse server URL.
LANGFUSE_HOST=http://localhost:3000
# NextAuth secret for the Langfuse web UI (change in production).
LANGFUSE_SECRET=
# Salt for Langfuse token hashing (change in production).
LANGFUSE_SALT=
